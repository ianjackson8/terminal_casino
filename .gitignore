# Git internals (never tracked anyway)
.git

# Virtual environments
path/
venv/
.venv/
env/
myenv/

# Python
__pycache__/
*.py[cod]

# Player profiles (local saves)
profiles/

# Games are installed from games.lock (scripts/games.py sync) or the release bundle, not stored in git
plugins/*
!plugins/.gitkeep

# Release builds (scripts/games.py)
dist/
